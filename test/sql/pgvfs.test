# name: test/sql/pgvfs.test
# description: pgvfs loads and fails cleanly without PostgreSQL (the storage
#   itself is tested against real PostgreSQL by scripts/contract.sh)
# group: [pgvfs]

require parquet

require pgvfs

query I
SELECT pgvfs_stats() LIKE '{"opens": %"reads": %}'
----
true

query I
SELECT current_setting('parquet_metadata_cache')
----
true

statement error
SELECT * FROM 'pgvfs://lake/missing.parquet'
----
pgvfs needs PostgreSQL credentials

# Tantivy splits use any DuckDB filesystem; here, local files.
query I
SELECT tantivy_index('__TEST_DIR__/docs.tantivy',
    '[{"name": "id", "type": "i64", "options": {"stored": true, "indexed": true}},
      {"name": "body", "type": "text", "options": {"indexing": {"record": "position", "tokenizer": "en_stem"}}}]',
    to_json(t))
FROM (VALUES (1, 'quick brown foxes'), (2, 'lazy cats')) t(id, body)
----
2

query II
SELECT score > 0, (doc->>'id')::INTEGER FROM tantivy_search('__TEST_DIR__/docs.tantivy', 'fox')
----
true	1

statement error
SELECT tantivy_index('__TEST_DIR__/docs.tantivy', '[]', '{}')
----
already exists

query I
SELECT tantivy_drop('__TEST_DIR__/docs.tantivy')
----
true

statement error
FROM tantivy_search('__TEST_DIR__/docs.tantivy', 'fox')
----
no tantivy split
