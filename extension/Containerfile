# The pgvfs DuckDB extension, linked the way DuckDB's own loadable
# extensions are: statically against duckdb_static of the exact DuckDB build
# that will load it (DuckDB's Python module loads with RTLD_LOCAL, so an
# extension cannot rely on the host's C++ symbols). DuckDB is never compiled:
# the `duckdb` build context is prepared by scripts/duckdb.sh (source tree
# for headers, prebuilt static libs, footer version).
#
#   just ext            # stable release -> target/ext/release/
#   just ext nightly    # newest 2.0 dev wheel -> target/ext/nightly/

FROM rust:1-bookworm AS rust
WORKDIR /src
COPY Cargo.toml Cargo.lock schema.sql ./
COPY src/ src/
COPY tantivy/ tantivy/
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo build --release --locked --lib \
 && cp target/release/libpgvfs.a /libpgvfs.a

FROM debian:bookworm AS link
RUN apt-get update \
 && apt-get install -y --no-install-recommends binutils cmake g++ \
 && rm -rf /var/lib/apt/lists/*
COPY --from=duckdb src/ /duckdb/src/
COPY --from=duckdb libs/ /duckdb/libs/
COPY --from=duckdb version /duckdb/version
COPY extension/ /ext/
COPY --from=rust /libpgvfs.a /libpgvfs.a
ARG PGVFS_VERSION=dev
RUN PGVFS_VERSION="$PGVFS_VERSION" bash /ext/build.sh /duckdb/src /duckdb/libs /libpgvfs.a "$(cat /duckdb/version)" /pgvfs.duckdb_extension

FROM scratch
COPY --from=link /pgvfs.duckdb_extension /
